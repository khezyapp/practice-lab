# Keep the build context small and the image reproducible.
# Without this, `docker build` uploads the local node_modules and any stale build.

.git
.gitignore
node_modules
docs/.vitepress/dist
docs/.vitepress/cache

# Docker-related files are not needed inside the image.
Dockerfile
.dockerignore
docker-compose.yml

# Repo files that are not part of the site.
labs
sample.yaml
README.md
.github
.vscode
